# App runtime
SECRET_KEY=django-insecure-12345678901234567890123456789012
HOSTING_SERVICE_PORT=8002
DEBUG=true
# One-time web bootstrap token for creating the first superuser when DEBUG=false.
# Leave empty and use `uv run python manage.py createsuperuser` in production.
# When set, open `/?setup_token=<token>` once to use the web form.
SETUP_TOKEN=
LOG_LEVEL=DEBUG
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
POSTGRES_DATABASE_URL=
# Postgres SSL when DEBUG=false (set false for Coolify internal DB without TLS)
POSTGRES_SSL_REQUIRE=true
# Redis. Required when DEBUG=false (rate limits and the in-container scheduler).
# With DEBUG=true, leave unset: the web app starts and the scheduler stays off.
# REDIS_URL=redis://127.0.0.1:6379/0
# In-container scheduler (Celery worker and beat). false keeps it out of this process.
SCHEDULER_ENABLED=true
# CELERY_BROKER_URL defaults to REDIS_URL. It does not replace REDIS_URL.
# CELERY_BROKER_URL=
# CELERY_WORKER_CONCURRENCY=2
# API CORS is permissive by default (Bearer JWT). Set false + CORS_ALLOWED_ORIGINS for lock-down.
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5174,https://admin.shellui.com

# Identity — set IDENTITY_SERVICE_URL; JWKS is derived as {url}/.well-known/jwks.json
# Override with IDENTITY_JWKS_URL only if JWKS lives on a different host.
# Or pin keys locally (production): IDENTITY_JWKS_FILE=... / IDENTITY_JWKS={...}
IDENTITY_SERVICE_URL=http://localhost:8000
IDENTITY_JWKS_URL=
IDENTITY_JWKS_FILE=
IDENTITY_JWKS=
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=
JWKS_CACHE_TTL=900
JWKS_TIMEOUT=15
JWKS_RETRIES=2
JWT_HS256_FALLBACK_SECRET=
JWT_ALGORITHMS=RS256

# Artifact storage: filesystem (local) or s3 (production)
HOSTING_BACKEND=filesystem
MEDIA_ROOT=
HOSTING_KEY_PREFIX=hosting

# S3 (when HOSTING_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_S3_ADDRESSING_STYLE=

# Public browsable app URLs — canonical domain for API links (serving accepts any domain)
HOSTING_APP_DOMAIN=shellui.local
HOSTING_APP_SCHEME=http
# In DEBUG, allow any Host header (default). Set false to restrict to ALLOWED_HOSTS.
HOSTING_ALLOW_ANY_HOST=true
# Skip company waitlist in local dev only (explicit opt-in; blocked when DEBUG=false)
HOSTING_DEBUG_OPEN=true
# Django admin UI (cross-tenant). Set false when unused — see docs/security-hardening.md
DJANGO_ADMIN_ENABLED=true
# Rate limits (see docs/security-hardening.md)
HOSTING_RATE_LIMIT_ENABLED=true
# HOSTING_RATE_LIMIT_DEPLOY=30
# HOSTING_RATE_LIMIT_UPLOAD=20
# HOSTING_RATE_LIMIT_DESTRUCTIVE=10
# HOSTING_RATE_LIMIT_ACCESS_REQUEST=10
# HTTPS / HSTS / secure cookies (defaults on when DEBUG=false)
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# Reverse proxies that may set X-Forwarded-For (IPs or CIDRs). Empty = trust REMOTE_ADDR only.
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# Hosted-app serve: in-process slug cache TTL (seconds). 0 = off. Default 45.
HOSTING_SERVE_CACHE_TTL_SECONDS=45
# Optional 301 for apex `/` (e.g. https://shellui.com). Empty → show landing page.
# Optional 301 for apex `/` only. Leave empty on shellui.app to show the Hosting landing.
# Example (legacy): ROOT_REDIRECT_URL=https://shellui.com
ROOT_REDIRECT_URL=
# Optional overrides for apex landing links
# SHELLUI_WEBSITE_URL=https://shellui.com
# SHELLUI_DOCS_URL=https://docs.shellui.com
# SHELLUI_PLAYGROUND_URL=https://playground.shellui.com
# SHELLUI_GITHUB_URL=https://github.com/shellui
# SHELLUI_AI_URL=https://shellui.ai

# Quotas
HOSTING_MAX_APPS_PER_COMPANY=5
HOSTING_MAX_DEPLOYMENTS_PER_APP=20
HOSTING_MAX_UPLOAD_BYTES=100M
HOSTING_MAX_EXTRACT_FILES=5000
HOSTING_MAX_EXTRACT_BYTES=500M
HOSTING_MAX_EXTRACT_FILE_BYTES=100M

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# Shellui Actions (webhooks)
ACTIONS_OUTBOX_MAX_ATTEMPTS=8
ACTIONS_WEBHOOK_TIMEOUT_SECONDS=5
ACTIONS_WEBHOOK_RETRY_LEASE_SECONDS=120
ACTIONS_WEBHOOK_DISPATCH_WORKERS=4
# Set true in tests; production uses async post-commit delivery
ACTIONS_WEBHOOK_SYNC_DELIVERY=false
# Allow localhost webhook URLs in DEBUG (or per-rule allow_private_urls for staff)
ACTIONS_WEBHOOK_ALLOW_PRIVATE=false

# Days to keep the event log and finished webhook deliveries (purged by `manage.py purge_expired_data`)
EVENT_LOG_RETENTION_DAYS=7

# email-service. Leave the API key empty to disable forwarding.
# URL is the origin only (no path). Default https://email.shellui.com
EMAIL_SERVICE_URL=https://email.shellui.com
EMAIL_SERVICE_API_KEY=
# Set true only when EMAIL_SERVICE_URL is a private or loopback address.
# EMAIL_SERVICE_ALLOW_PRIVATE=false
