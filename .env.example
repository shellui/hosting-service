# hosting-service settings. Full reference: docs/configuration.md
# Generated from config/env_registry.py: python manage.py generate_env --example > .env.example
# Production: python manage.py generate_env --host hosting.example.com
# Copy to .env for local runs. Commented-out lines show the default the code uses.

# Required
# Local development key only. Production needs 50+ random characters (generate_env).
SECRET_KEY=django-insecure-local-development-only-0123456789abcdef
# Local development only. Unset means false (production).
DEBUG=true
# Local identity-service. JWKS is fetched from {url}/.well-known/jwks.json in DEBUG.
IDENTITY_SERVICE_URL=http://localhost:8000
# Local dev: skip the company waitlist (refused when DEBUG=false).
HOSTING_DEBUG_OPEN=true

# Required when DEBUG=false (production)
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
HOSTING_APP_DOMAIN=
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=
IDENTITY_JWKS=
REDIS_URL=
POSTGRES_DATABASE_URL=

# Optional (defaults shown)

# Runtime
# LOG_LEVEL=INFO
# SETUP_TOKEN=
# DJANGO_ADMIN_ENABLED=true
# HOSTING_SERVICE_PORT=8002

# Database: SQLite unless POSTGRES_DATABASE_URL is set
# SQLITE_PATH=db.sqlite3
# POSTGRES_SSL_REQUIRE=true

# Identity and JWT
# IDENTITY_JWKS_FILE=
# IDENTITY_JWKS_URL=
# IDENTITY_SYNC_TIMEOUT=10
# JWKS_CACHE_TTL=900
# JWKS_TIMEOUT=15
# JWKS_RETRIES=2
# JWT_ALGORITHMS=RS256
# JWT_HS256_FALLBACK_SECRET=
# ALLOW_JWT_HS256_FALLBACK=false

# Public URLs and serving
# HOSTING_APP_SCHEME=https
# HOSTING_ALLOW_ANY_HOST=false
# HOSTING_SERVE_CACHE_TTL_SECONDS=45
# HOSTING_PREVIEW_TTL_DAYS=7

# Quotas
# HOSTING_MAX_APPS_PER_COMPANY=5
# HOSTING_MAX_DEPLOYMENTS_PER_APP=20
# HOSTING_MAX_UPLOAD_BYTES=100M
# HOSTING_MAX_EXTRACT_FILES=5000
# HOSTING_MAX_EXTRACT_BYTES=500M
# HOSTING_MAX_EXTRACT_FILE_BYTES=100M
# DATA_UPLOAD_MAX_MEMORY_SIZE=12M

# Artifact storage: filesystem or s3
# HOSTING_BACKEND=filesystem
# MEDIA_ROOT=
# HOSTING_KEY_PREFIX=hosting
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
# AWS_S3_SIGNATURE_VERSION=s3v4
# AWS_S3_ADDRESSING_STYLE=

# Rate limits (requests per window)
# HOSTING_RATE_LIMIT_ENABLED=true
# HOSTING_RATE_LIMIT_DEPLOY=30
# HOSTING_RATE_LIMIT_UPLOAD=20
# HOSTING_RATE_LIMIT_DESTRUCTIVE=10
# HOSTING_RATE_LIMIT_ACCESS_REQUEST=10

# CORS and HTTPS
# CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOW_CREDENTIALS=false
# CORS_ALLOWED_ORIGINS=
# CORS_ALLOW_PRIVATE_NETWORK=true
# TRUSTED_PROXY_IPS=
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true

# Scheduled jobs
# SCHEDULER_ENABLED=true
# CELERY_BROKER_URL=
# CELERY_WORKER_CONCURRENCY=2
# CELERY_BEAT_SCHEDULE_FILE=/tmp/celerybeat-schedule

# Shellui Actions (webhooks)
# ACTIONS_OUTBOX_MAX_ATTEMPTS=8
# ACTIONS_WEBHOOK_TIMEOUT_SECONDS=5
# ACTIONS_WEBHOOK_RETRY_LEASE_SECONDS=120
# ACTIONS_WEBHOOK_DISPATCH_WORKERS=4
# ACTIONS_WEBHOOK_SYNC_DELIVERY=false
# ACTIONS_WEBHOOK_ALLOW_PRIVATE=false
# EVENT_LOG_RETENTION_DAYS=7

# Email notifications: off while EMAIL_SERVICE_API_KEY is empty
# EMAIL_SERVICE_API_KEY=
# EMAIL_SERVICE_URL=https://email.shellui.com
# EMAIL_SERVICE_ALLOW_PRIVATE=false

# Apex landing
# ROOT_REDIRECT_URL=
# SHELLUI_WEBSITE_URL=https://shellui.com
# SHELLUI_DOCS_URL=https://docs.shellui.com
# SHELLUI_PLAYGROUND_URL=https://playground.shellui.com
# SHELLUI_GITHUB_URL=https://github.com/shellui
# SHELLUI_AI_URL=https://shellui.ai
# HOSTING_REGION=

# Error reporting
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0

# Gunicorn (Docker entrypoint)
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
